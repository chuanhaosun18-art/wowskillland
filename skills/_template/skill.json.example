{
  "name": "论文选题收敛术",
  "description": "把被导师退回来、范围太大的研究选题，一步步收窄成能落地执行的问题，并给出每一步的判断依据。",
  "category": "论文写作",
  "tags": ["选题", "开题报告", "文献检索", "研究生"],
  "version": "1.0.0",
  "task_intent": "thesis_topic",
  "goal": "在 2 小时内把过宽的研究选题收敛到可执行范围，且能说清为什么砍掉这些方向。",
  "done_criteria": [
    "选题用一句话说清要解决什么问题",
    "列出收窄前后的对比和被砍掉的方向及理由",
    "给出下一步 3 天内可执行的动作清单"
  ],
  "workflow": [
    "第一步：抄录导师退回的原话和选题现状，不做任何加工",
    "第二步：把选题拆成子问题，按「能不能拿到数据、有没有现有解法」打分",
    "第三步：砍掉得分最低的方向，保留一个主问题和一个备选",
    "第四步：把主问题写成一句话假设，交给导师确认"
  ],
  "boundary": {
    "not_applicable": ["纯情绪倾诉没有具体任务目标", "导师尚未给任何反馈的首次选题"],
    "handoff_trigger": ["需要实验数据但用户提供不了", "选题依赖的文献平台无法访问"],
    "fallback_path": "给一份自查清单，让用户先对照自己的题目自评"
  },
  "contract": {
    "input": "一段选题现状描述 + 导师的原话反馈",
    "output": "收窄后的选题陈述 + 砍掉方向的理由 + 3 天动作清单",
    "permissions": ["read_upload"]
  },
  "gotchas": [
    "导师退回两次以上要优先处理挫败情绪，而不是直接给方案",
    "不要一次砍到底，先收敛到两个候选再让用户选"
  ]
}
